# Pooled Neon connection used by the serverless application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma migration commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_example"
CLERK_SECRET_KEY="sk_test_example"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example"

# Optional: leave empty for regex extraction and unavailable AI insights.
OPENAI_API_KEY=""
OPENAI_EXTRACTION_MODEL="gpt-4o-mini"
OPENAI_INSIGHTS_MODEL="gpt-4o-mini"

# Dedicated disposable database used only by npm run test:db.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require"
ALLOW_DATABASE_TESTS="false"
